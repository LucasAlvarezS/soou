# Claves de API para los agentes solo-lectura del harness (soou.config.json).
# Copia este archivo a .env y completa SOLO las que uses. .env esta en .gitignore.
# Cada agente se activa solo cuando su variable existe; el resto queda inactivo
# sin romper nada. Verifica con: python soou.py agents

# Comodin: un endpoint y una key para modelos de casi cualquier proveedor.
OPENROUTER_API_KEY=

# Inferencia rapida y barata (buena para el nivel trivial del router).
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Proveedores directos.
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
